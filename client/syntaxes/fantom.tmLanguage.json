{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Fantom",
  "scopeName": "source.fantom",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#uriLiterals" },
    { "include": "#dslLiterals" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#storageTypes" },
    { "include": "#constants" },
    { "include": "#facets" },
    { "include": "#typeDeclarations" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.fandoc.fantom",
          "begin": "^\\s*\\*\\*",
          "end": "$",
          "patterns": [
            {
              "name": "markup.bold.fantom",
              "match": "\\*\\*[^*]+\\*\\*"
            },
            {
              "name": "markup.italic.fantom",
              "match": "\\*[^*]+\\*"
            },
            {
              "name": "markup.inline.raw.fantom",
              "match": "'[^']+'",
              "captures": {}
            }
          ]
        },
        {
          "name": "comment.block.fantom",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            { "include": "#comments" }
          ]
        },
        {
          "name": "comment.line.double-slash.fantom",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.fantom",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#stringInterpolation" },
            { "include": "#stringEscapes" }
          ]
        },
        {
          "name": "string.quoted.double.fantom",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#stringInterpolation" },
            { "include": "#stringEscapes" }
          ]
        },
        {
          "name": "string.quoted.single.fantom",
          "match": "'(\\\\.|[^'\\\\])'"
        }
      ]
    },
    "stringInterpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.fantom",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.interpolation.begin.fantom" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.interpolation.end.fantom" }
          },
          "patterns": [
            { "include": "source.fantom" }
          ]
        },
        {
          "name": "variable.other.interpolation.fantom",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*"
        }
      ]
    },
    "stringEscapes": {
      "patterns": [
        {
          "name": "constant.character.escape.fantom",
          "match": "\\\\(b|f|n|r|t|\\\\|\\$|\"|'|u[0-9a-fA-F]{4})"
        }
      ]
    },
    "uriLiterals": {
      "patterns": [
        {
          "name": "string.other.uri.fantom",
          "begin": "`",
          "end": "`",
          "patterns": [
            { "include": "#stringInterpolation" },
            { "include": "#stringEscapes" }
          ]
        }
      ]
    },
    "dslLiterals": {
      "patterns": [
        {
          "name": "string.unquoted.dsl.fantom",
          "begin": "([A-Z][a-zA-Z0-9_]*)\\s*<\\|",
          "end": "\\|>",
          "beginCaptures": {
            "1": { "name": "entity.name.type.dsl.fantom" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.fantom",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.float.fantom",
          "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?[fFdD]?\\b"
        },
        {
          "name": "constant.numeric.duration.fantom",
          "match": "\\b[0-9][0-9_]*(ns|ms|sec|min|hr|day)\\b"
        },
        {
          "name": "constant.numeric.integer.fantom",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.fantom",
          "match": "\\b(if|else|while|for|foreach|do|switch|case|default|break|continue|return|throw|try|catch|finally|as|is|isnot)\\b"
        },
        {
          "name": "keyword.declaration.fantom",
          "match": "\\b(class|mixin|enum|facet|using|pod)\\b"
        },
        {
          "name": "storage.modifier.fantom",
          "match": "\\b(abstract|const|final|native|once|override|private|protected|public|internal|readonly|static|virtual|volatile|new)\\b"
        },
        {
          "name": "keyword.other.fantom",
          "match": "\\b(it|this|super)\\b"
        }
      ]
    },
    "storageTypes": {
      "patterns": [
        {
          "name": "storage.type.fantom",
          "match": "\\b(Void|Bool|Int|Float|Decimal|Str|Uri|Duration|Type|Slot|Range|List|Map|Obj|Num|Err)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.fantom",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "facets": {
      "patterns": [
        {
          "name": "meta.facet.fantom",
          "match": "@[A-Z][a-zA-Z0-9_]*(\\.[a-zA-Z0-9_]+)*",
          "captures": {
            "0": { "name": "entity.other.attribute-name.fantom" }
          }
        }
      ]
    },
    "typeDeclarations": {
      "patterns": [
        {
          "match": "\\b(class|mixin|enum)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.fantom" },
            "2": { "name": "entity.name.type.fantom" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.fantom",
          "match": "(===|!==|==|!=|<=>|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.fantom",
          "match": "(=|\\+=|-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.arithmetic.fantom",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.fantom",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.null.fantom",
          "match": "(\\?:|\\?\\.|\\.\\?|\\?)"
        },
        {
          "name": "keyword.operator.range.fantom",
          "match": "(\\.\\.<|\\.\\.)"
        },
        {
          "name": "keyword.operator.arrow.fantom",
          "match": "(->|<-)"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.type.fantom",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
