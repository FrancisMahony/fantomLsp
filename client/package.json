{
  "name": "fantom-lsp",
  "displayName": "Fantom Language Support",
  "description": "Language server protocol support for the Fantom programming language",
  "version": "0.1.1",
  "publisher": "fantom-lsp",
  "license": "AFL-3.0",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "keywords": [
    "fantom",
    "fan",
    "skyspark",
    "lsp",
    "language server"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:fantom"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fantom",
        "aliases": [
          "Fantom",
          "fantom",
          "fan"
        ],
        "extensions": [
          ".fan",
          ".fwt",
          ".pod"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fantom",
        "scopeName": "source.fantom",
        "path": "./syntaxes/fantom.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Fantom",
      "properties": {
        "fantom.home": {
          "type": "string",
          "default": "",
          "description": "Path to Fantom installation directory (FAN_HOME). If empty, the extension will check the FAN_HOME environment variable and PATH."
        },
        "fantom.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Fantom language server."
        },
        "fantom.javaOpts": {
          "type": "string",
          "default": "-Xmx1024m",
          "description": "JVM options passed to the Fantom language server (e.g. -Xmx2048m for more memory)."
        },
        "fantom.formatting.bracketStyle": {
          "type": "string",
          "enum": [
            "allman",
            "k&r"
          ],
          "default": "allman",
          "enumDescriptions": [
            "Allman style - braces on new line (e.g., class Foo\\n{)",
            "K&R style - braces on same line (e.g., class Foo {)"
          ],
          "description": "Bracket style to use when formatting code."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --minify",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "minimatch": "^10.2.1"
  }
}
